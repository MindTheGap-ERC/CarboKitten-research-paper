	author = {Thomas, Franck and Godard, Vincent and Bellier, Olivier and Benedetti, Lucilla and Ollivier, Vincent and Rizza, Magali and Guillou, Valéry and Hollender, Fabrice and Aumaître, Georges and Bourlès, Didier L. and Keddadouche, Karim},
