@article{hutton_sedflux_2008,
	series = {Predictive {Modeling} in {Sediment} {Transport} and {Stratigraphy}},
	title = {\textit{{Sedflux} 2.0}: {An} advanced process-response model that generates three-dimensional stratigraphy},
	volume = {34},
	issn = {0098-3004},
	shorttitle = {\textit{{Sedflux} 2.0}},
	url = {https://www.sciencedirect.com/science/article/pii/S0098300408000587},
	doi = {10.1016/j.cageo.2008.02.013},
	abstract = {Sedflux 2.0 is the newest version of the Sedflux basin-filling model. Sedflux 2.0 provides a framework within which individual process-response models of disparate time and space resolutions communicate with one another to deliver multigrain-sized sediment load across a continental margin. Version 2.0 introduces a series of new process models, and the ability to operate in one of two modes to track the evolution of stratigraphy in either two or three dimensions. Additions to the 2D mode include the addition of models that simulate (1) erosion and deposition of sediment along a riverbed, (2) cross-shore transport due to ocean waves, and (3) turbidity currents and hyperpycnal flows. New processes in the 3D mode include (1) river channel avulsion, (2) two-dimensional diffusion due to ocean storms, and (3) two-dimensional flexure due to sediment loading. The spatial resolution of the architecture is typically 1–25cm in the vertical and 10–100m in the horizontal when operating in 2D mode. In 3D mode, the horizontal resolution usually extends to kilometers. In addition to fixed time steps (from days to hundreds of years), Sedflux 2.0 offers event-based time stepping as a way to conduct long-term simulations while still modeling low-frequency but high-energy events.},
	number = {10},
	urldate = {2025-05-30},
	journal = {Computers \& Geosciences},
	author = {Hutton, Eric W. H. and Syvitski, James P. M.},
	month = oct,
	year = {2008},
	keywords = {Boundary-layer transport, Flexure, Plumes, Stratigraphy, Turbidity currents},
	pages = {1319--1337},
}

