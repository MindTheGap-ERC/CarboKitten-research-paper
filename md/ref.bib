@article{holland_quality_2000,
	title = {The quality of the fossil record: {A} sequence stratigraphic perspective},
	volume = {26},
	issn = {0094-8373, 1938-5331},
	shorttitle = {The quality of the fossil record},
	url = {https://www.cambridge.org/core/journals/paleobiology/article/abs/quality-of-the-fossil-record-a-sequence-stratigraphic-perspective/A98FF56DD49FFCB5703A0AB887CA02DD},
	doi = {10.1017/S0094837300026919},
	abstract = {As paleobiology continues to address an ever broader array of questions, it becomes increasingly important to interpret confidently the meaning of the pattern of fossil occurrences as found in outcrop. To this end, sequence stratigraphy is an important tool for paleobiologists because it predicts the distribution of unconformities, facies changes, and changes in sedimentation rate, all factors known from numerous previous studies to affect the quality of the fossil record. Computer simulations now make it possible not only to model sequence architecture within sedimentary basins, but also to model the occurrence of fossils within those basins. These models generate predictions regarding the stratigraphic distribution of first and last occurrences, changes in species abundance, changes in species morphology, and the distribution of gaps in fossil ranges. Although confirmation of some of these predictions has been found in field studies, the extent to which these predictions describe the fossil record in general is still unknown. If the predicted patterns of fossil occurrences are found to be widespread, it will suggest that a relatively simple model of fossil occurrences in outcrops could become a new tool for solving a wide array of paleobiologic and biostratigraphic problems. With such models, paleobiologists and biostratigraphers will be able to use model data to test the accuracy of newly developed methods of analysis.},
	language = {en},
	number = {S4},
	urldate = {2024-05-26},
	journal = {Paleobiology},
	author = {Holland, Steven M.},
	month = jan,
	year = {2000},
	pages = {148--168},
}


@article{hutton_sedflux_2008,
	series = {Predictive {Modeling} in {Sediment} {Transport} and {Stratigraphy}},
	title = {\textit{{Sedflux} 2.0}: {An} advanced process-response model that generates three-dimensional stratigraphy},
	volume = {34},
	issn = {0098-3004},
	shorttitle = {\textit{{Sedflux} 2.0}},
	url = {https://www.sciencedirect.com/science/article/pii/S0098300408000587},
	doi = {10.1016/j.cageo.2008.02.013},
	abstract = {Sedflux 2.0 is the newest version of the Sedflux basin-filling model. Sedflux 2.0 provides a framework within which individual process-response models of disparate time and space resolutions communicate with one another to deliver multigrain-sized sediment load across a continental margin. Version 2.0 introduces a series of new process models, and the ability to operate in one of two modes to track the evolution of stratigraphy in either two or three dimensions. Additions to the 2D mode include the addition of models that simulate (1) erosion and deposition of sediment along a riverbed, (2) cross-shore transport due to ocean waves, and (3) turbidity currents and hyperpycnal flows. New processes in the 3D mode include (1) river channel avulsion, (2) two-dimensional diffusion due to ocean storms, and (3) two-dimensional flexure due to sediment loading. The spatial resolution of the architecture is typically 1–25cm in the vertical and 10–100m in the horizontal when operating in 2D mode. In 3D mode, the horizontal resolution usually extends to kilometers. In addition to fixed time steps (from days to hundreds of years), Sedflux 2.0 offers event-based time stepping as a way to conduct long-term simulations while still modeling low-frequency but high-energy events.},
	number = {10},
	urldate = {2025-05-30},
	journal = {Computers \& Geosciences},
	author = {Hutton, Eric W. H. and Syvitski, James P. M.},
	month = oct,
	year = {2008},
	keywords = {Boundary-layer transport, Flexure, Plumes, Stratigraphy, Turbidity currents},
	pages = {1319--1337},
}

